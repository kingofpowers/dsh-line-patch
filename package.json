{
  "name": "dsh-line-patch",
  "version": "0.3.1",
  "description": "Anchored line patching for DeepSeek Harness: read/write/edit results carry a short file hash, and patch rewrites a line range only when that hash and both boundary-line anchors still match.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kingofpowers/dsh-line-patch.git"
  },
  "homepage": "https://github.com/kingofpowers/dsh-line-patch#readme",
  "bugs": {
    "url": "https://github.com/kingofpowers/dsh-line-patch/issues"
  },
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "cordis",
    "edit",
    "patch",
    "hash",
    "anchor"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "manifestVersion": 1
  },
  "engines": {
    "dsh": ">=0.2.1-rc.1 <0.3.0",
    "node": ">=20"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/dsh-llm": "*"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "check": "node --check lib/core.js && node --check lib/index.js"
  },
  "license": "MIT",
  "author": "kingofpowers",
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    }
  }
}
